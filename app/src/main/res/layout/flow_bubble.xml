<?xml version="1.0" encoding="utf-8"?>
<!-- Clean Flow Bubble: idle pill mic; listening = Cancel | status | Done -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/bubble_pulse_ring"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bubble_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <include layout="@layout/bubble_close" />

        <include layout="@layout/bubble_wave" />

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/flow_bubble_desc_idle"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic" />

        <TextView
            android:id="@+id/bubble_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:text="@string/flow_bubble_idle"
            android:textColor="#FFF4EFE6"
            android:textSize="13sp"
            android:visibility="gone" />

        <include layout="@layout/bubble_ok" />

        <TextView
            android:id="@+id/bubble_chip_copy"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/flow_bubble_copy"
            android:textColor="#FFF4EFE6"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bubble_chip_undo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/flow_bubble_undo"
            android:textColor="#FFF4EFE6"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bubble_chip_paste"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/flow_bubble_paste"
            android:textColor="#FFF4EFE6"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bubble_chip_lang"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:alpha="0.7"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="EN"
            android:textColor="#FFF4EFE6"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
